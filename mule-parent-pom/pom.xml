<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.audi</groupId>
    <artifactId>mule-parent-pom</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>mule-parent-pom</name>
    <description>Shared parent POM for Audi MuleSoft applications. Manages connector, module and plugin versions centrally.</description>

    <!-- ============================================================
         Version properties — bump here, inherit everywhere
         N-1 versions resolved 2026-11-01 from repository.mulesoft.org
         ============================================================ -->
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Mule runtime (used by mule-maven-plugin cloudHub2 target) -->
        <app.runtime>4.11.6</app.runtime>

        <!-- N-1: latest stable was 4.10.3 → N-1 = 4.10.2 -->
        <mule.maven.plugin.version>4.10.2</mule.maven.plugin.version>

        <!-- N-1: latest stable was 1.12.2 → N-1 = 1.12.1 -->
        <http.connector.version>1.12.1</http.connector.version>

        <!-- N-1: latest stable was 1.13.4 → N-1 = 1.13.3 -->
        <apikit.module.version>1.13.3</apikit.module.version>

        <!-- FILL ME: Anypoint Exchange organisation ID (Business Group ID) -->
        <!-- Used in distributionManagement URL below -->
        <anypoint.org.id>FILL_ME_ANYPOINT_ORG_ID</anypoint.org.id>
    </properties>

    <!-- ============================================================
         Dependency version management
         Child POMs declare groupId + artifactId only (no version/classifier).
         ============================================================ -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.mule.connectors</groupId>
                <artifactId>mule-http-connector</artifactId>
                <version>${http.connector.version}</version>
                <classifier>mule-plugin</classifier>
            </dependency>
            <dependency>
                <groupId>org.mule.modules</groupId>
                <artifactId>mule-apikit-module</artifactId>
                <version>${apikit.module.version}</version>
                <classifier>mule-plugin</classifier>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- ============================================================
         Plugin version management
         ============================================================ -->
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.mule.tools.maven</groupId>
                    <artifactId>mule-maven-plugin</artifactId>
                    <version>${mule.maven.plugin.version}</version>
                    <extensions>true</extensions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!-- ============================================================
         Repositories — inherited by all children
         ============================================================ -->
    <repositories>
        <repository>
            <id>anypoint-exchange-v3</id>
            <name>Anypoint Exchange v3</name>
            <url>https://maven.anypoint.mulesoft.com/api/v3/maven</url>
            <layout>default</layout>
        </repository>
        <repository>
            <id>mulesoft-releases</id>
            <name>MuleSoft Releases</name>
            <url>https://repository.mulesoft.org/releases/</url>
            <layout>default</layout>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>mulesoft-releases</id>
            <name>MuleSoft Releases</name>
            <url>https://repository.mulesoft.org/releases/</url>
            <layout>default</layout>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>

    <!-- ============================================================
         Distribution management — publish parent to Anypoint Exchange
         Credentials come from settings.xml (server id: anypoint-exchange-v3)
         ============================================================ -->
    <distributionManagement>
        <repository>
            <id>anypoint-exchange-v3</id>
            <name>Anypoint Exchange v3</name>
            <url>https://maven.anypoint.mulesoft.com/api/v3/organizations/${anypoint.org.id}/maven</url>
        </repository>
    </distributionManagement>

    <!-- ============================================================
         Profiles — CloudHub 2.0 only (RTF and on-prem removed)
         ============================================================ -->
    <profiles>
        <profile>
            <id>cloudhub2</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.mule.tools.maven</groupId>
                        <artifactId>mule-maven-plugin</artifactId>
                        <version>${mule.maven.plugin.version}</version>
                        <configuration>
                            <cloudHub2Deployment>
                                <!-- FILL ME: Azure DevOps pipeline sets these via -D flags -->
                                <uri>https://anypoint.mulesoft.com</uri>
                                <provider>MC</provider>
                                <environment>FILL_ME_ENVIRONMENT</environment>
                                <businessGroupId>${anypoint.org.id}</businessGroupId>
                                <applicationName>${project.artifactId}</applicationName>
                                <muleVersion>${app.runtime}</muleVersion>
                                <replicas>1</replicas>
                                <vCores>0.1</vCores>
                            </cloudHub2Deployment>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
